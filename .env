# ─── first-run sizing: small on purpose ───────────────────────────────────────
BET_USD=10
SLOTS=1
MIN_EDGE_CENTS=6
DAILY_LOSS_LIMIT_USD=150

# ─── oracle ───────────────────────────────────────────────────────────────────
ORACLE_VENUES=coinbase,kraken,bitstamp
MIN_VENUES=2
INDEX_LAG_HALFLIFE_S=9
COINBASE_MAKER_SIDE=true

# ─── gates ────────────────────────────────────────────────────────────────────
MIN_SECONDS_TO_CLOSE=90
MAX_SECONDS_TO_CLOSE=2700
MAX_SPREAD_CENTS=4
MIN_BOOK_DEPTH=25
MAX_ABS_Z=2.2
MAX_MODEL_DISAGREE=0.14

# ─── execution ────────────────────────────────────────────────────────────────
ORDER_STYLE=limit_touch
ORDER_TTL_S=25
FEE_RATE=0.07
SLIPPAGE_CENTS=0.5

# ─── exits ────────────────────────────────────────────────────────────────────
TAKE_PROFIT_CENTS=14
STOP_EDGE_CENTS=-6
HOLD_TO_SETTLE_Z=1.6
